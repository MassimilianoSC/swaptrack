rules_version = '2';

// SPEC §7.3, R7: decided by path and claims only, never by cross-service reads.
service firebase.storage {
  match /b/{bucket}/o {
    // Public: the sign-in page shows the logo. Written only by the settings callable (Admin SDK).
    match /branding/{file} {
      allow read: if file.matches('logo[.][a-z]+');
    }

    // §7.3: photos of the own ASP; a user in the grace period may still upload (§4.8). Max 5 MB, images only.
    match /photos/{aspId}/{eventId}/{file} {
      allow create: if request.auth != null && request.auth.token.orgId == aspId
        && request.auth.token.role in ['asp_technician', 'asp_warehouse', 'asp_admin']
        && (request.auth.token.active == true || request.auth.token.disabledAt is number)
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && request.auth.token.active == true
        && (request.auth.token.role in ['client_admin', 'client_office', 'client_warehouse'] || request.auth.token.orgId == aspId);
    }

    // §11.2 / DECISIONS b5: documents live at documents/{aspId}/{kind}/{documentId}/{n}.{ext}, aspId being the
    // ASP of the document's location (P-49). Writes always go through the server (Admin SDK). Reads are gated by
    // kind so technicians can see BOMs of their own ASP and client_warehouse can see return DDTs, as in §3.3.
    match /documents/{scope}/{kind}/{documentId}/{file} {
      allow read: if request.auth != null && request.auth.token.active == true && (
        request.auth.token.role in ['client_admin', 'client_office']
        || (request.auth.token.role in ['asp_admin', 'asp_warehouse'] && scope == request.auth.token.orgId)
        || (request.auth.token.role == 'asp_technician'
              && kind == 'bom' && scope == request.auth.token.orgId)
        || (request.auth.token.role == 'client_warehouse'
              && kind == 'ddt_return')
      );
    }

    // §13.3 / §13.4 exports and reports: readable by client roles and by the asp_admin of the scope.
    match /exports/{scope}/{file} {
      allow read: if request.auth != null && request.auth.token.active == true && (
        request.auth.token.role in ['client_admin', 'client_office']
        || (request.auth.token.role == 'asp_admin' && scope == request.auth.token.orgId)
      );
    }
    match /reports/{scope}/{file} {
      allow read: if request.auth != null && request.auth.token.active == true && (
        request.auth.token.role in ['client_admin', 'client_office']
        || (request.auth.token.role == 'asp_admin' && scope == request.auth.token.orgId)
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
