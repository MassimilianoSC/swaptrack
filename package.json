{
  "name": "swaptrack",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "build:functions": "cd functions && yarn build",
    "watch:functions": "cd functions && yarn watch",
    "emulators": "yarn build:functions && firebase emulators:start --project demo-swaptrack --import ./.emulator-data --export-on-exit ./.emulator-data",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "deploy": "yarn build && yarn build:functions && firebase deploy",
    "seed:full": "node scripts/fullSeed.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "barcode-detector": "3.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "firebase": "12",
    "i18next": "26.5.11",
    "lucide-react": "1.64.0",
    "react": "19",
    "react-dom": "19",
    "react-i18next": "17.1.9",
    "react-router": "7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zxing-wasm": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "5",
    "autoprefixer": "^10.6.2",
    "firebase-admin": "13",
    "firebase-tools": "^15.34.2",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4",
    "typescript": "5.8",
    "vite": "7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "3"
  }
}
