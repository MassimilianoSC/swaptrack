{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "src",
        "*.log"
      ],
      "predeploy": [
        "yarn --cwd \"$RESOURCE_DIR\" build"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "target": "app",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 9109
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8190,
      "websocketPort": 9160
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5011
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9209
    },
    "pubsub": {
      "host": "127.0.0.1",
      "port": 8095
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9309
    },
    "tasks": {
      "host": "127.0.0.1",
      "port": 9509
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4410
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4510
    },
    "ui": {
      "enabled": false
    }
  }
}
