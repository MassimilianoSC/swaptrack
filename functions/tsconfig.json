{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2023"],
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "noUnusedLocals": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
