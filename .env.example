# Firebase web configuration (SPEC c7). Never hard-coded: fill with your project's values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true only for local development on the Firebase emulators
VITE_USE_EMULATORS=false
# Optional: reCAPTCHA Enterprise site key for App Check (monitoring mode, §4.17)
VITE_APPCHECK_SITE_KEY=
